{
  "style": "dark",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 36,
  "templating": {
    "list": [
      {
        "id": "00000000-0000-0000-0000-000000000000",
        "type": "query",
        "name": "job",
        "hide": 0,
        "skipUrlSync": false,
        "label": "Job",
        "query": "label_values(up, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "refresh": 2,
        "includeAll": true,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "system-monitoring",
  "title": "System Monitoring",
  "description": "CPU, memory, disk, and network metrics from node_exporter",
  "tags": [
    "linux",
    "node-exporter",
    "generated"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"$job\"}[5m])) * 100)",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "{{ instance }}"
        }
      ],
      "title": "CPU Usage",
      "description": "Average CPU utilisation across all cores",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=~\"$job\"} / node_memory_MemTotal_bytes{job=~\"$job\"}))",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "{{ instance }}"
        }
      ],
      "title": "Memory Usage",
      "description": "Used RAM as a percentage of total",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{job=~\"$job\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{job=~\"$job\",mountpoint=\"/\",fstype!=\"rootfs\"}) * 100)",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "{{ instance }}"
        }
      ],
      "title": "Disk Usage",
      "description": "Root filesystem usage",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{job=~\"$job\"}",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "{{ instance }}"
        }
      ],
      "title": "System Uptime",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "CPU",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"$job\"}[5m])) * 100)",
          "refId": "",
          "legendFormat": "{{ instance }}"
        }
      ],
      "title": "CPU Usage %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h"
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{job=~\"$job\"}[5m])) * 100",
          "refId": "",
          "legendFormat": "{{ mode }}"
        }
      ],
      "title": "CPU by Mode",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "repeatDirection": "h"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=~\"$job\"} - node_memory_MemAvailable_bytes{job=~\"$job\"}",
          "refId": "",
          "legendFormat": "Used \u2014 {{ instance }}"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{job=~\"$job\"}",
          "refId": "",
          "legendFormat": "Available \u2014 {{ instance }}"
        }
      ],
      "title": "Memory Usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "repeatDirection": "h"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Network",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=~\"$job\",device!=\"lo\"}[5m])",
          "refId": "",
          "legendFormat": "{{ instance }} \u2014 {{ device }}"
        }
      ],
      "title": "Network Received",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "repeatDirection": "h"
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(node_network_transmit_bytes_total{job=~\"$job\",device!=\"lo\"}[5m])",
          "refId": "",
          "legendFormat": "{{ instance }} \u2014 {{ device }}"
        }
      ],
      "title": "Network Transmitted",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "repeatDirection": "h"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Disk I/O",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{job=~\"$job\"}[5m])",
          "refId": "",
          "legendFormat": "{{ instance }} \u2014 {{ device }}"
        }
      ],
      "title": "Disk Read Throughput",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "repeatDirection": "h"
    },
    {
      "type": "timeseries",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(node_disk_written_bytes_total{job=~\"$job\"}[5m])",
          "refId": "",
          "legendFormat": "{{ instance }} \u2014 {{ device }}"
        }
      ],
      "title": "Disk Write Throughput",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "repeatDirection": "h"
    }
  ]
}
