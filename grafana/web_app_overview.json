{
  "style": "dark",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 36,
  "templating": {
    "list": [
      {
        "id": "00000000-0000-0000-0000-000000000000",
        "type": "custom",
        "name": "env",
        "hide": 0,
        "skipUrlSync": false,
        "label": "Environment",
        "query": "production,staging,development",
        "multi": false,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "web-app-overview",
  "title": "Web App Overview",
  "description": "Rate, Error, Duration \u2014 the three RED signals for HTTP services",
  "tags": [
    "web",
    "red-method",
    "generated"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "15s",
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{env=~\"$env\"}[5m]))",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "req/s"
        }
      ],
      "title": "Request Rate",
      "description": "HTTP requests per second (all status codes)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{env=~\"$env\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{env=~\"$env\"}[5m]))",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "error %"
        }
      ],
      "title": "Error Rate",
      "description": "Percentage of 5xx responses over the last 5 minutes",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "stat",
      "transparent": false,
      "transformations": [],
      "options": null,
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{env=~\"$env\"}[5m])))",
          "refId": "",
          "instant": true,
          "range": false,
          "legendFormat": "p99"
        }
      ],
      "title": "p99 Latency",
      "description": "99th-percentile request duration",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
